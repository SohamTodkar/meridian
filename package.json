{
  "name": "ideas-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development next dev --webpack",
    "build": "NODE_ENV=production next build --webpack",
    "start": "NODE_ENV=production next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm typecheck",
    "test": "vitest run --config vitest.config.mts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@rive-app/react-canvas": "4.32.0",
    "framer-motion": "13.1.0",
    "fuse.js": "7.5.0",
    "gray-matter": "4.0.3",
    "lenis": "1.3.26",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "4.4.3",
    "three": "0.185.1",
    "unified": "^11.0.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.19.30",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "eslint": "9.22.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
