# ──────────────────────────────────────────────────────────────
# Meridian · research desk keys (optional)
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real keys to enable the
# Research desk (Exa neural search + Firecrawl extraction).
#
#   EXA_API_KEY      → https://dashboard.exa.ai/api-keys
#   FIRECRAWL_API_KEY → https://firecrawl.dev
#
# Meridian runs fully without these keys — every learning feature is
# local-first and offline. Only the /research desk needs them, and the
# keys are read exclusively server-side (never shipped to the browser).
# .env.local is git-ignored; never commit real keys.

EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: canonical URL used for sitemap.xml, robots.txt and Open Graph.
# NEXT_PUBLIC_SITE_URL=https://your-meridian-host.example
